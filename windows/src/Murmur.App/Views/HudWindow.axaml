<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:Murmur.App.Localization"
        xmlns:controls="using:Murmur.App.Controls"
        x:Class="Murmur.App.Views.HudWindow"
        Title="Murmur HUD"
        SizeToContent="WidthAndHeight"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        CanResize="False"
        WindowStartupLocation="Manual">

    <Grid x:Name="HudViewport"
          Width="{DynamicResource HudViewportWidth}"
          Height="{DynamicResource HudViewportHeight}">
        <Border x:Name="HudSurface"
                Classes="hudSurface"
                Width="{DynamicResource HudOrbDiameter}"
                Height="{DynamicResource HudOrbDiameter}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource HudChassisBrush}"
                BorderBrush="{DynamicResource HudSpecularHairlineBrush}"
                BorderThickness="{DynamicResource HudBorderThickness}"
                CornerRadius="{DynamicResource HudOrbRadius}"
                RenderTransformOrigin="50%,50%">
            <Panel>
                <Panel x:Name="RecordingRim"
                       Classes="hudRecordingRim"
                       Margin="-1"
                       IsHitTestVisible="False">
                    <Border x:Name="RecordingWash" CornerRadius="{Binding #HudSurface.CornerRadius}"
                            BorderThickness="4"
                            BorderBrush="{DynamicResource HudRecordingEdgeBrush}"
                            Opacity="0.30" />
                    <Border x:Name="RecordingStroke" CornerRadius="{Binding #HudSurface.CornerRadius}"
                            BorderThickness="1.5"
                            BorderBrush="{DynamicResource HudRecordingEdgeBrush}" />
                </Panel>
                <!-- Rainbow rim shown only while transcribing (Finishing). Margin cancels
                     HudBorderThickness so the stroke traces the outer pill silhouette, which
                     stays inside the native window region. -->
                <Panel x:Name="RainbowRim"
                       Classes="hudRainbowRim"
                       Margin="-1"
                       IsHitTestVisible="False">
                    <Panel.Resources>
                        <ConicGradientBrush x:Key="HudRainbowBrush" Center="50%,50%" Angle="-90">
                            <GradientStop Offset="0" Color="#FFFF5E7E" />
                            <GradientStop Offset="0.14" Color="#FFFF9F0A" />
                            <GradientStop Offset="0.28" Color="#FFFFD60A" />
                            <GradientStop Offset="0.42" Color="#FF30D158" />
                            <GradientStop Offset="0.57" Color="#FF64D2FF" />
                            <GradientStop Offset="0.71" Color="#FF0A84FF" />
                            <GradientStop Offset="0.86" Color="#FFBF5AF2" />
                            <GradientStop Offset="1" Color="#FFFF5E7E" />
                        </ConicGradientBrush>
                    </Panel.Resources>
                    <!-- Soft inner wash; an outer glow would be clipped by the native region. -->
                    <Border CornerRadius="{Binding #HudSurface.CornerRadius}"
                            BorderThickness="4"
                            BorderBrush="{StaticResource HudRainbowBrush}"
                            Opacity="0.2" />
                    <Border CornerRadius="{Binding #HudSurface.CornerRadius}"
                            BorderThickness="1.5"
                            BorderBrush="{StaticResource HudRainbowBrush}" />
                </Panel>
            </Panel>
        </Border>

        <Border x:Name="HudContentSurface"
                Classes="hudContentSurface"
                Width="{DynamicResource HudArmedWidth}"
                Height="{DynamicResource HudArmedHeight}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                Padding="{DynamicResource HudPadding}"
                Opacity="0"
                IsHitTestVisible="False">
            <Grid ColumnDefinitions="Auto,Auto,*"
                  ColumnSpacing="{DynamicResource HudColumnSpacing}">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource HudLampBadgeSpacing}"
                            VerticalAlignment="Center">
                    <Border Padding="1.5" CornerRadius="6"
                            BorderThickness="0.75"
                            BorderBrush="{DynamicResource SeamBrush}"
                            Background="{DynamicResource PanelShadeBrush}"
                            VerticalAlignment="Center">
                        <Ellipse x:Name="RecordLamp"
                                 Width="{DynamicResource LampDiameter}"
                                 Height="{DynamicResource LampDiameter}"
                                 Fill="{DynamicResource HudIdleLampBrush}"
                                 VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TelemetryBadge"
                               Text="{x:Static localization:UiText.HudArm}"
                               Classes="silkscreen"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ProfileBadge"
                               Text="STD"
                               Classes="silkscreen"
                               VerticalAlignment="Center" />
                </StackPanel>

                <controls:VUMeterControl Grid.Column="1"
                                         x:Name="HudMeter"
                                         UseHudPalette="True"
                                         Width="{DynamicResource HudMeterWidth}"
                                         Height="{DynamicResource HudMeterHeight}"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="{x:Static localization:UiText.HudRecordingLevel}" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource HudLampBadgeSpacing}"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TranscriptText"
                               Classes="hudTranscript"
                               Text="{x:Static localization:UiText.HudHoldToSpeak}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource InkPrimaryBrush}"
                               MaxWidth="{DynamicResource HudTranscriptMaxWidth}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <StackPanel x:Name="ProcessingDots"
                                Orientation="Horizontal"
                                Spacing="{DynamicResource HudProcessingDotSpacing}"
                                IsVisible="False">
                        <Ellipse x:Name="ProcessingDot1" Width="{DynamicResource HudProcessingDotSize}" Height="{DynamicResource HudProcessingDotSize}" Fill="{DynamicResource HudProcessingBrush}" />
                        <Ellipse x:Name="ProcessingDot2" Width="{DynamicResource HudProcessingDotSize}" Height="{DynamicResource HudProcessingDotSize}" Fill="{DynamicResource HudProcessingBrush}" />
                        <Ellipse x:Name="ProcessingDot3" Width="{DynamicResource HudProcessingDotSize}" Height="{DynamicResource HudProcessingDotSize}" Fill="{DynamicResource HudProcessingBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
